{
  "manifest_version": 3,
  "name": "FlickWaySurfer",
  "version": "1.0.0",
  "description": "Subway Surfers gameplay in a floating window beside your Flick lectures. Resize it, hide it, keep it in full screen. Unofficial.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flick.docchula.com/*"
      ],
      "js": [
        "content/surfer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Show or hide Subway Surfers (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Show or hide the Subway Surfers window"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
